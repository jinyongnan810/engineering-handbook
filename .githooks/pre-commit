#!/bin/sh
set -eu

PATH="$HOME/.local/share/mise/shims:$HOME/.nvm/versions/node/v22.20.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
export PATH

hook_dir=${0%/*}
cd "$hook_dir/.."

# If any content file is staged, generate up-to-date page dates and stage the json
if git diff --cached --name-only | grep -q '^content/'; then
  echo "Content changes detected. Generating page last-edited dates..."
  node scripts/generate-page-dates.js
  git add src/data/pageDates.json
fi

before=$(mktemp)
after=$(mktemp)
trap 'rm -f "$before" "$after"' EXIT

git diff --no-ext-diff --binary > "$before"

echo "Running make lint before commit..."
make lint

# If pageDates.json was formatted during make lint, re-stage it
if git diff --cached --name-only | grep -q '^content/'; then
  git add src/data/pageDates.json
fi

git diff --no-ext-diff --binary > "$after"

if ! cmp -s "$before" "$after"; then
  echo
  echo "make lint changed files. Stage the updated files and commit again:"
  git diff --name-only
  exit 1
fi
